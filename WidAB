function tbadge(t){ const m=TYPE[t]; return `<span class="tb" style="background:${m.c}">${m.e} ${m.name}</span>`; }
function statBar(lbl,v,max,col){ return `<div class="stat"><b>${lbl}</b><div class="bar"><i style="width:${clamp(v/max*100,8,100)}%;background:${col}"></i></div></div>`; }
function cardInner(c){
  const moves = c.moves.map(id=>{const m=MOVE[id]; return `<div class="ml" style="background:${TYPE[m.type].c}" title="${m.desc||''}">${m.name}</div>`;}).join('');
  return `<div class="name-reveal">${c.name}</div>
    <div class="ava" style="background:radial-gradient(circle at 40% 30%, ${shade(c.color,40)}, ${c.color})">${c.emoji}</div>
    <h3>${c.name}</h3><div class="tbadges">${tbadge(c.type)}</div>
    <div class="stats">${statBar('HP',c.hp,350,'#5fd05f')}${statBar('ATK',c.atk,1.3,'#f28b4a')}${statBar('DEF',c.def,1.3,'#4aa3f2')}${statBar('SPE',c.spe,1.3,'#c87af2')}</div>
    <div class="movelist">${moves}</div>
    <div style="font-size:10px;color:#67748f;margin-top:2px">${c.blurb}</div>`;
}
function openShop(){ buildShop(); show('shop'); }
function buildShop(){ const g=$('shopGrid'); g.innerHTML='';
  CHARS.forEach(c=>{ const owned=SAVE.owned.includes(c.id), eq=SAVE.equipped===c.id;
    const card=document.createElement('div'); card.className='fcard';
    let tag=owned?`<div class="own-tag">Owned</div>`:`<div class="lock-tag">🪙 ${c.price}</div>`; if(eq)tag+=`<div class="equip-tag">Equipped</div>`;
    card.innerHTML=tag+cardInner(c);
    const btn=document.createElement('button'); btn.className='btn sm shop-btn';
    const act=()=>{ if(eq)return; if(owned)equipChar(c.id); else buyChar(c.id); };
    if(eq){ btn.classList.add('alt'); btn.textContent='Equipped ✓'; }
    else if(owned){ btn.textContent='Equip ⚔️'; }
    else { if(SAVE.coins<c.price)btn.classList.add('alt'); btn.textContent='Buy 🪙'+c.price; }
    btn.onclick=e=>{ e.stopPropagation(); act(); };
    if(!eq){ card.style.cursor='pointer'; card.onclick=act; }
    card.appendChild(btn); g.appendChild(card); });
}
function buyChar(id){ const c=CHAR(id); if(!c)return; if(SAVE.owned.includes(id)){ equipChar(id); return; }
  if(SAVE.coins<c.price){ toast(`Need 🪙${c.price} · you have 🪙${SAVE.coins}`); return; }
  SAVE.coins-=c.price; SAVE.owned.push(id); SAVE.equipped=id; persist(); toast('Unlocked '+c.name+'! 🎉'); refreshCoins(); buildShop(); }
function equipChar(id){ SAVE.equipped=id; persist(); toast('Equipped '+CHAR(id).name); buildShop(); }
window.buyChar=buyChar; window.equipChar=equipChar;

window.setFormat=f=>{ S.format=f; document.querySelectorAll('.fmt').forEach(b=>b.classList.toggle('on',b.dataset.fmt===f)); };
window.startSurvival=()=>{ setFormat('survival'); chooseMode('cpu'); };
window.chooseMode=m=>{ S.mode=m; S.selIdx=0; S.players=[null,null]; buildSelect(); show('select'); };
function buildSelect(){ $('whoPicks').textContent=(S.mode==='pvp')?(S.selIdx===0?'Player 1':'Player 2'):'You';
  const g=$('fgrid'); g.innerHTML='';
  CHARS.forEach(c=>{ const owned=SAVE.owned.includes(c.id);
    const card=document.createElement('div'); card.className='fcard'+(owned?' pick':'');
    const tag = owned?(SAVE.equipped===c.id?`<div class="equip-tag">Equipped</div>`:''):`<div class="lock-tag">🪙 ${c.price}</div>`;
    card.innerHTML=tag+cardInner(c);
    const btn=document.createElement('button'); btn.className='btn sm shop-btn';
    if(owned){ btn.textContent='Pick ✓'; const go=()=>pickChar(c); btn.onclick=e=>{e.stopPropagation();go();}; card.onclick=go; }
    else { if(SAVE.coins<c.price)btn.classList.add('alt'); btn.textContent='Buy 🪙'+c.price;
      const buy=()=>{ if(SAVE.coins>=c.price){ buyChar(c.id); buildSelect(); } else toast(`Need 🪙${c.price} · you have 🪙${SAVE.coins}`); };
      btn.onclick=e=>{e.stopPropagation();buy();}; card.style.cursor='pointer'; card.onclick=buy; }
    card.appendChild(btn); g.appendChild(card); });
}
function pickChar(c){
  if(S.mode==='pvp'){ S.players[S.selIdx]=makePlayer(c,S.selIdx); if(S.selIdx===0){ S.selIdx=1; SAVE.equipped=c.id; persist(); buildSelect(); return; } }
  else { S.players[0]=makePlayer(c,0); SAVE.equipped=c.id; persist();
    if(S.format==='survival'){ const pool=shuffle(CHARS.filter(x=>x.id!==c.id)); S.survivalPool=pool; S.survivalIdx=0; S.streak=0; S.players[1]=makePlayer(pool[0],1,true); }
    else S.players[1]=makePlayer(pick(CHARS),1,true); }
  startSeries();
}
function makePlayer(c,idx,isCPU=false){
  return { c, idx, isCPU, name:c.name, emoji:c.emoji, type:c.type, maxHP:c.hp, hp:c.hp,
    atkStage:0, protect:false, protectStreak:0, boost:0, dealt:0,
    pp:Object.fromEntries(c.moves.map(id=>[id,MOVE[id].pp])),
    anim:{dance:'idle',t0:performance.now(),dur:Infinity} };
}
function shade(hex,amt){ const n=parseInt(hex.slice(1),16); let r=clamp((n>>16)+amt,0,255),g=clamp(((n>>8)&255)+amt,0,255),b=clamp((n&255)+amt,0,255);
  return '#'+((1<<24)+(r<<16)+(g<<8)+b).toString(16).slice(1); }

