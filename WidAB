<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Wat in de Aura Battles</title>
<style>
  :root{
    --ink:#15223b;--accent:#ff3d81;--gold:#ffcc29;--lime:#8bd450;
    --panel:#ffffff;--panel2:#f3f6fc;--line:#c9d4e8;
    --hype:#ff7a1a;--flex:#e24aa0;--sport:#2aa84a;--tech:#3a7bd5;--troll:#8a4ad5;--aura:#e3a81e;
    --disp:"Haettenschweiler","Arial Narrow Bold","Impact","Franklin Gothic Bold",system-ui,sans-serif;
    --body:"Trebuchet MS","Segoe UI",system-ui,-apple-system,sans-serif;
    --shadow:0 12px 34px rgba(21,34,59,.2);
  }
  *{box-sizing:border-box;margin:0;padding:0;-webkit-tap-highlight-color:transparent}
  html,body{height:100%}
  body{font-family:var(--body);color:var(--ink);min-height:100%;overflow:hidden;
    background:linear-gradient(165deg,#eaf3ff 0%,#f6ecff 50%,#fff3e6 100%);}
  #app{position:fixed;inset:0;display:flex;align-items:center;justify-content:center;padding:12px 12px 56px}
  #fx{position:fixed;inset:0;pointer-events:none;z-index:40}
  .screen{width:100%;max-width:1120px;max-height:100%;display:none;flex-direction:column}
  .screen.on{display:flex;animation:pop .4s cubic-bezier(.2,1.3,.4,1)}
  @keyframes pop{from{opacity:0;transform:translateY(12px)}to{opacity:1;transform:none}}
  .btn{font-family:var(--disp);font-size:24px;letter-spacing:.03em;text-transform:uppercase;border:3px solid var(--ink);
    background:var(--gold);color:var(--ink);padding:11px 24px;border-radius:14px;cursor:pointer;box-shadow:0 5px 0 var(--ink);
    transition:transform .08s,box-shadow .08s,background .15s}
  .btn:hover{background:#ffd94d}.btn:active{transform:translateY(4px);box-shadow:0 1px 0 var(--ink)}
  .btn.alt{background:#fff}.btn.sm{font-size:17px;padding:7px 15px;box-shadow:0 4px 0 var(--ink)}
  .btn:disabled{opacity:.45;cursor:not-allowed}
  .coins{display:inline-flex;align-items:center;gap:6px;font-family:var(--disp);font-size:21px;background:#fff;
    border:3px solid var(--ink);border-radius:99px;padding:3px 15px;box-shadow:0 4px 0 var(--ink)}
  .kicker{font-weight:800;letter-spacing:.26em;text-transform:uppercase;font-size:12px;color:var(--accent)}

  /* title */
  #title{align-items:center;text-align:center;gap:4px}
  .logo{font-family:var(--disp);line-height:.84;text-transform:uppercase}
  .logo .l1{display:block;font-size:clamp(24px,5.5vw,50px);transform:rotate(-3deg)}
  .logo .l2{display:block;font-size:clamp(54px,14vw,128px);
    background:linear-gradient(100deg,var(--troll),var(--accent) 55%,var(--gold));-webkit-background-clip:text;background-clip:text;color:transparent;
    filter:drop-shadow(0 5px 0 rgba(21,34,59,.9));transform:rotate(-2deg);animation:wob 3.4s ease-in-out infinite}
  @keyframes wob{0%,100%{transform:rotate(-2deg)}50%{transform:rotate(1deg) scale(1.02)}}
  .tag-badge{display:inline-block;font-family:var(--disp);font-size:clamp(15px,3vw,22px);background:var(--ink);color:#fff;padding:3px 15px;border-radius:99px;transform:rotate(-1.5deg)}
  .subtitle{font-size:14px;max-width:600px;margin:12px auto 2px;color:#45506a;line-height:1.5}
  .mode-row{display:flex;gap:12px;flex-wrap:wrap;justify-content:center;margin-top:14px;align-items:center}
  .fmt-row{display:flex;gap:7px;justify-content:center;flex-wrap:wrap;margin-top:12px}
  .fmt{font-family:var(--disp);font-size:16px;text-transform:uppercase;cursor:pointer;border:3px solid var(--ink);background:#fff;
    color:var(--ink);padding:6px 14px;border-radius:99px;box-shadow:0 3px 0 var(--ink);transition:transform .08s,background .15s}
  .fmt:hover{background:#fff2d6}.fmt.on{background:var(--accent);color:#fff}.fmt:active{transform:translateY(3px);box-shadow:none}
  .foot-tip{text-align:center;font-size:11px;color:#7a86a0;font-weight:700;letter-spacing:.05em}

  /* grids: select + shop */
  .toprow{display:flex;justify-content:space-between;align-items:center;margin-bottom:8px;gap:10px;flex-wrap:wrap}
  .sel-head h2{font-family:var(--disp);font-size:clamp(26px,6vw,42px);text-transform:uppercase}
  #whoPicks{font-weight:800;color:var(--accent)}
  .grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px;width:100%;overflow:auto;padding:4px 2px}
  @media(max-width:800px){.grid{grid-template-columns:repeat(2,minmax(0,1fr))}}
  .fcard{background:var(--panel);border:3px solid var(--ink);border-radius:18px;padding:12px;box-shadow:0 6px 0 var(--ink);
    text-align:center;position:relative;overflow:hidden;display:flex;flex-direction:column;gap:5px}
  .fcard.pick{cursor:pointer;transition:transform .12s}.fcard.pick:hover{transform:translateY(-4px)}
  .shop-btn{width:100%;margin-top:8px}
  .name-reveal{position:absolute;left:0;right:0;top:0;z-index:4;pointer-events:none;background:var(--ink);color:#fff;font-family:var(--disp);
    font-size:20px;text-transform:uppercase;letter-spacing:.03em;padding:7px 6px;text-align:center;
    transform:translateY(-102%);transition:transform .2s cubic-bezier(.2,1.3,.4,1)}
  .fcard:hover .name-reveal{transform:translateY(0)}
  .fcard .ava{width:84px;height:84px;margin:2px auto 0;border-radius:50%;display:flex;align-items:center;justify-content:center;
    font-size:46px;border:3px solid var(--ink);box-shadow:inset 0 -8px 14px rgba(0,0,0,.12)}
  .fcard h3{font-family:var(--disp);font-size:21px;text-transform:uppercase;line-height:1}
  .tbadges{display:flex;gap:5px;justify-content:center;flex-wrap:wrap}
  .tb{font-size:10px;font-weight:800;letter-spacing:.08em;text-transform:uppercase;color:#fff;padding:2px 9px;border-radius:99px;border:2px solid rgba(0,0,0,.25)}
  .fcard .stats{display:flex;flex-direction:column;gap:3px;margin:2px 0;font-size:10px;text-align:left}
  .stat{display:flex;align-items:center;gap:6px}.stat b{width:38px;font-weight:800;text-transform:uppercase;color:#67748f}
  .stat .bar{flex:1;height:6px;border-radius:99px;background:#e5ebf5;border:1.5px solid var(--ink);overflow:hidden}
  .stat .bar i{display:block;height:100%}
  .movelist{display:grid;grid-template-columns:1fr 1fr;gap:4px;margin-top:2px}
  .ml{font-size:9.5px;font-weight:800;color:#fff;padding:3px 5px;border-radius:7px;text-align:left;border:2px solid rgba(0,0,0,.22);line-height:1.1}
  .lock-tag{position:absolute;top:8px;right:8px;background:var(--ink);color:#fff;font-weight:800;font-size:11px;padding:3px 9px;border-radius:99px}
  .own-tag{position:absolute;top:8px;right:8px;background:var(--lime);color:var(--ink);font-weight:800;font-size:10px;padding:3px 9px;border-radius:99px;border:1.5px solid var(--ink)}
  .equip-tag{position:absolute;top:8px;left:8px;background:var(--gold);color:var(--ink);font-weight:800;font-size:10px;padding:3px 9px;border-radius:99px;border:1.5px solid var(--ink)}

  /* ---------- battle (Showdown style) ---------- */
  #battle{gap:8px;height:100%}
  #stage{position:relative;flex:1;min-height:0;border:3px solid var(--ink);border-radius:18px;overflow:hidden;box-shadow:0 8px 0 var(--ink)}
  #three{position:absolute;inset:0;width:100%;height:100%;display:block}
  .infobox{position:absolute;z-index:3;background:rgba(255,255,255,.94);border:3px solid var(--ink);border-radius:12px;padding:6px 10px;min-width:min(44%,300px);box-shadow:var(--shadow)}
  .infobox.foe{top:12px;right:12px}
  .infobox.me{bottom:12px;left:12px}
  .ib-top{display:flex;align-items:center;gap:7px;justify-content:space-between}
  .ib-name{font-family:var(--disp);font-size:19px;text-transform:uppercase;line-height:1;display:flex;align-items:center;gap:6px}
  .ib-types{display:flex;gap:4px}
  .hpwrap{margin-top:5px;display:flex;align-items:center;gap:7px}
  .hpbar{flex:1;height:11px;background:#2a2f3a;border:2px solid var(--ink);border-radius:99px;overflow:hidden;position:relative}
  .hpbar i{display:block;height:100%;border-radius:99px;transition:width .55s cubic-bezier(.3,1,.4,1),background .3s}
  .hptxt{font-size:11px;font-weight:800;min-width:66px;text-align:right;color:#39445c;font-variant-numeric:tabular-nums}
  .ib-status{display:flex;gap:4px;margin-top:4px;min-height:15px}
  .st{font-size:9px;font-weight:800;letter-spacing:.05em;text-transform:uppercase;padding:1px 7px;border-radius:99px;border:1.5px solid var(--ink)}
  .st.up{background:#d9ffd1}.st.guard{background:#d4ecff}.st.down{background:#ffd9e4}

  .series-pill{position:absolute;z-index:3;top:12px;left:50%;transform:translateX(-50%);font-family:var(--disp);font-size:14px;
    text-transform:uppercase;background:var(--ink);color:#fff;padding:3px 13px;border-radius:99px}
  .battlelog{position:absolute;z-index:3;left:12px;top:84px;width:min(32%,250px);max-height:36%;overflow:hidden;
    background:rgba(21,34,59,.82);color:#eef3ff;border-radius:10px;padding:8px 10px;font-size:11.5px;line-height:1.45;display:flex;flex-direction:column-reverse}
  .battlelog .ln{opacity:0;animation:lnin .3s forwards}
  .battlelog b{color:var(--gold)}.battlelog .se{color:#8bd450;font-weight:800}.battlelog .nv{color:#ff9db6;font-weight:800}.battlelog .cr{color:#ffd34a;font-weight:800}
  @keyframes lnin{to{opacity:1}}
  @media(max-width:760px){.battlelog{display:none}.infobox{min-width:52%}}
  .bubble{position:absolute;z-index:4;background:#fff;border:3px solid var(--ink);border-radius:14px;padding:5px 11px;font-weight:800;
    font-size:clamp(11px,2.4vw,15px);box-shadow:var(--shadow);opacity:0;transform:scale(.6);max-width:40%}
  .bubble.l{left:7%;top:40%}.bubble.r{right:7%;top:18%;text-align:right}

  .menu{border:3px solid var(--ink);border-radius:16px;background:var(--panel);box-shadow:0 6px 0 var(--ink);padding:9px}
  .menu-prompt{font-family:var(--disp);font-size:18px;text-transform:uppercase;margin:0 2px 7px;color:#39445c}
  .menu-prompt b{color:var(--accent)}
  .moves{display:grid;grid-template-columns:1fr 1fr;gap:8px}
  @media(max-width:520px){.moves{grid-template-columns:1fr}}
  .mv{position:relative;border:3px solid rgba(0,0,0,.3);border-radius:12px;cursor:pointer;padding:8px 11px;text-align:left;color:#fff;
    box-shadow:0 4px 0 rgba(0,0,0,.3);transition:transform .08s,box-shadow .08s,filter .12s;overflow:hidden}
  .mv:hover:not(:disabled){filter:brightness(1.08);transform:translateY(-2px)}
  .mv:active:not(:disabled){transform:translateY(3px);box-shadow:0 1px 0 rgba(0,0,0,.3)}
  .mv:disabled{opacity:.4;cursor:not-allowed}
  .mv .mvn{font-family:var(--disp);font-size:19px;text-transform:uppercase;line-height:1;text-shadow:0 1px 2px rgba(0,0,0,.3)}
  .mv .mvsub{display:flex;justify-content:space-between;align-items:center;margin-top:5px;font-size:10px;font-weight:800;text-transform:uppercase;opacity:.95}
  .mv .mvtype{background:rgba(0,0,0,.22);padding:1px 7px;border-radius:99px;letter-spacing:.06em}
  .mv .mvdesc{margin-top:5px;font-size:11px;font-weight:700;line-height:1.25;opacity:.96;text-shadow:0 1px 1px rgba(0,0,0,.25)}
  .cpu-note{text-align:center;font-size:12px;font-weight:800;color:#7a86a0;letter-spacing:.06em;text-transform:uppercase;min-height:15px}

  /* result */
  #result{align-items:center;text-align:center;gap:8px}
  .crown{font-size:62px;animation:bobf 2s ease-in-out infinite}@keyframes bobf{0%,100%{transform:translateY(0)}50%{transform:translateY(-6px)}}
  .result-logo{font-family:var(--disp);font-size:clamp(36px,8vw,74px);text-transform:uppercase;line-height:.9;
    background:linear-gradient(100deg,var(--troll),var(--accent),var(--gold));-webkit-background-clip:text;background-clip:text;color:transparent;filter:drop-shadow(0 4px 0 rgba(21,34,59,.85))}
  .result-sub{font-size:15px;color:#45506a;max-width:520px;line-height:1.5}
  .aura-score{font-family:var(--disp);font-size:clamp(24px,5vw,44px)}.aura-score b{color:var(--accent)}
  .coin-win{font-family:var(--disp);font-size:24px;color:#b8860b}

  .fnum{position:fixed;z-index:50;font-family:var(--disp);font-size:38px;pointer-events:none;-webkit-text-stroke:2px var(--ink)}
  .toast{position:fixed;left:50%;top:13%;transform:translateX(-50%);z-index:60;background:var(--ink);color:#fff;font-family:var(--disp);font-size:19px;padding:7px 19px;border-radius:99px;opacity:0}
</style>
</head>
<body>
<canvas id="fx"></canvas>
<div class="toast" id="toast"></div>
<div id="app">

  <section id="title" class="screen on">
    <div class="kicker">The viral 1v1 dance-type battler</div>
    <div class="logo"><span class="l1">Wat in de</span><span class="l2">Aura Battles</span></div>
    <div class="tag-badge">WidAB</div>
    <p class="subtitle">A 3D, Showdown-style dance-off. Every fighter runs a 4-move set, every dance has a <b>type</b>, and type matchups decide who gets mogged. Build energy, buff your power, bait a guard, and land a super-effective finisher.</p>
    <div class="fmt-row" id="fmtRow">
      <button class="fmt on" data-act="fmt" data-fmt="classic">⚡ Classic</button>
      <button class="fmt" data-act="fmt" data-fmt="bo3">🏆 Best of 3</button>
      <button class="fmt" data-act="fmt" data-fmt="sudden">☠️ Sudden Death</button>
    </div>
    <div class="mode-row">
      <button class="btn" data-act="mode" data-val="cpu">⚔️ VS CPU</button>
      <button class="btn alt" data-act="mode" data-val="pvp">🧑‍🤝‍🧑 2P Hotseat</button>
      <button class="btn alt" data-act="survival">🔥 Survival</button>
    </div>
    <div class="mode-row">
      <button class="btn alt sm" data-act="shop">🛒 Shop</button>
      <button class="btn alt sm" data-act="chart">📊 Type Chart</button>
      <span class="coins" id="titleCoins">🪙 0</span>
    </div>
    <p class="foot-tip" style="margin-top:10px">Loading the 3D arena… if it stays blank, your device may not support WebGL.</p>
  </section>

  <section id="shop" class="screen">
    <div class="toprow">
      <div><div class="kicker">Aura Coin Shop</div><div class="sel-head"><h2>Fighter Shop</h2></div></div>
      <div style="display:flex;gap:10px;align-items:center"><span class="coins" id="shopCoins">🪙 0</span>
        <button class="btn alt sm" data-act="back">← Back</button></div>
    </div>
    <div class="grid" id="shopGrid"></div>
  </section>

  <section id="select" class="screen">
    <div class="toprow">
      <div><div class="kicker">Choose your fighter</div>
        <div class="sel-head" style="text-align:left"><h2>Pick a Fighter</h2>
        <div style="font-size:14px"><span id="whoPicks">You</span>, who's got the aura?</div></div></div>
      <div style="display:flex;gap:10px;align-items:center"><span class="coins" id="selCoins">🪙 0</span>
        <button class="btn alt sm" data-act="shop">🛒 Shop</button>
        <button class="btn alt sm" data-act="back">← Back</button></div>
    </div>
    <div class="grid" id="fgrid"></div>
  </section>

  <section id="battle" class="screen">
    <div id="stage">
      <canvas id="three"></canvas>
      <div class="series-pill" id="seriesPill" style="display:none"></div>
      <div class="infobox foe" id="ibFoe"></div>
      <div class="infobox me" id="ibMe"></div>
      <div class="battlelog" id="blog"></div>
      <div class="bubble l" id="bub0"></div><div class="bubble r" id="bub1"></div>
    </div>
    <div class="menu" id="menu">
      <div class="menu-prompt" id="menuPrompt">What will <b>you</b> do?</div>
      <div class="moves" id="moves"></div>
    </div>
    <div class="cpu-note" id="cpunote"></div>
  </section>

  <section id="result" class="screen">
    <div class="crown" id="crown">👑</div>
    <div class="kicker" id="resKick">Winner</div>
    <div class="result-logo" id="resName">—</div>
    <div class="aura-score" id="resScore"></div>
    <div class="coin-win" id="resCoins"></div>
    <p class="result-sub" id="resSub"></p>
    <div class="mode-row">
      <button class="btn" data-act="rematch">🔁 Rematch</button>
      <button class="btn alt" data-act="back">🏠 Menu</button>
    </div>
  </section>
</div>
<script type="module">
import * as THREE from 'https://cdn.jsdelivr.net/npm/three@0.180.0/build/three.module.js';

/* ===================== TYPES ===================== */
const TYPE = {
  hype:{name:'Hype',c:'#ff7a1a',e:'🔥'}, flex:{name:'Flex',c:'#e24aa0',e:'💅'},
  sport:{name:'Sport',c:'#2aa84a',e:'🏀'}, tech:{name:'Tech',c:'#3a7bd5',e:'🤖'},
  troll:{name:'Troll',c:'#8a4ad5',e:'😈'}, aura:{name:'Aura',c:'#e3a81e',e:'✨'},
};
const BEATS = { hype:'flex', flex:'sport', sport:'tech', tech:'troll', troll:'hype' };
function typeMult(atk,def){ if(atk==='aura'||def==='aura') return 1; if(BEATS[atk]===def) return 1.5; if(BEATS[def]===atk) return 0.66; return 1; }

/* ===================== MOVES (dances) ===================== */
const MOVE = {
  dab:      {name:'Dab',           type:'flex',  cat:'dance', pow:55, acc:1,  pp:25, dance:'dab',       desc:'Reliable low-power hit.'},
  floss:    {name:'Floss',         type:'flex',  cat:'dance', pow:70, acc:.95,pp:20, dance:'floss',     desc:'Flashy mid-power hit.'},
  carlton:  {name:'The Carlton',   type:'flex',  cat:'dance', pow:78, acc:.95,pp:15, dance:'carlton',   desc:'Smooth, solid damage.'},
  sprinkler:{name:'Sprinkler',     type:'flex',  cat:'dance', pow:60, acc:1,  pp:20, dance:'sprinkler', desc:'Light hit, never misses.'},
  griddy:   {name:'The Griddy',    type:'sport', cat:'dance', pow:92, acc:.9, pp:10, dance:'griddy',    desc:'Heavy hit, can miss.'},
  running:  {name:'Running Man',   type:'sport', cat:'dance', pow:66, acc:1,  pp:20, dance:'running',   desc:'Quick, accurate hit.'},
  shoot:    {name:'Hit the Shoot', type:'sport', cat:'dance', pow:82, acc:.95,pp:15, dance:'shoot',     desc:'Strong, accurate hit.'},
  robot:    {name:'The Robot',     type:'tech',  cat:'dance', pow:76, acc:.95,pp:15, dance:'robot',     desc:'Steady tech damage.'},
  moonwalk: {name:'Moonwalk',      type:'aura',  cat:'dance', pow:80, acc:.95,pp:15, dance:'moonwalk',  desc:'Smooth neutral damage.'},
  spin:     {name:'Spin Move',     type:'aura',  cat:'dance', pow:62, acc:1,  pp:20, dance:'spin',      desc:'Light neutral damage.'},
  orange:   {name:'Orange Justice',type:'troll', cat:'dance', pow:72, acc:.95,pp:15, dance:'orange',    desc:'Chaotic mid-power hit.'},
  worm:     {name:'The Worm',      type:'troll', cat:'dance', pow:66, acc:.95,pp:15, dance:'worm',      desc:'Low, slippery hit.'},
  takel:    {name:'Take the L',    type:'troll', cat:'dance', pow:56, acc:1,  pp:15, dance:'takel', eff:'loweratk', desc:'Hits + lowers foe ATK.'},
  twerk:    {name:'Twerk',         type:'troll', cat:'dance', pow:52, acc:1,  pp:20, dance:'twerk', eff:'lowerdef', desc:'Chip + lowers foe DEF.'},
  gangnam:  {name:'Gangnam Style', type:'hype',  cat:'dance', pow:86, acc:.9, pp:10, dance:'gangnam',   desc:'Heavy hit, can miss.'},
  tpose:    {name:'T-Pose',        type:'aura',  cat:'status',pp:10, dance:'tpose',   eff:'protect',  desc:'Guard: blocks the next hit.'},
  macarena: {name:'Macarena',      type:'aura',  cat:'status',pp:10, dance:'macarena',eff:'heal',     desc:'Heal: restore 40% of your aura.'},
  defaultd: {name:'Default Dance', type:'hype',  cat:'status',pp:15, dance:'default', eff:'atkup',    desc:'Buff: raise your ATK (+1 stage).'},
  whip:     {name:'Whip / Nae Nae',type:'hype',  cat:'status',pp:15, dance:'whip',    eff:'boost',    desc:'Boost: your next hit deals +50%.'},
};

/* ===================== ROSTER ===================== */
const CHARS = [
  { id:'lars', name:'Lars', emoji:'🧔', type:'aura', price:0, color:'#7a6a55', head:'horns', acc:null,
    hp:355, atk:1.0, def:1.2, spe:.82, moves:['moonwalk','tpose','macarena'], sig:{name:'Dwarven Slam',pow:114,eff:'healself'}, blurb:'Stout dwarf. Unmovable, out-lasts everyone.' },
  { id:'dean', name:'Dean', emoji:'🕺', type:'flex', price:150, color:'#d94f86', head:'band', acc:null,
    hp:290, atk:1.08, def:.95, spe:1.18, moves:['carlton','floss','spin'], sig:{name:'Headspin Finale',pow:112}, blurb:'Breakdancer. Flows fast and flashy.' },
  { id:'metaai', name:'Meta AI', emoji:'🤖', type:'tech', price:200, color:'#3a7bd5', head:'cube', acc:null,
    hp:295, atk:1.05, def:1.05, spe:1.0, moves:['robot','takel','whip'], sig:{name:'Neural Overload',pow:110,eff:'lowerdef'}, blurb:'Chatbot. Debuffs and computes your demise.' },
  { id:'reshman', name:'Reshman', emoji:'👤', type:'troll', price:250, color:'#2a2a3a', head:'shadow', acc:null,
