<!DOCTYPE html>
<html lang="nl">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>ChaosChat</title>
<style>
  :root{
    --bg:#0d1117; --panel:#161b22; --panel2:#1c2230; --line:#2a3140;
    --text:#e6edf3; --muted:#8b98a9; --accent:#7c5cff; --accent2:#00d3a7;
    --danger:#ff5d6c; --warn:#ffb020; --gold:#ffd24a;
  }
  *{box-sizing:border-box}
  html,body{height:100%;margin:0}
  body{font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Helvetica,Arial,sans-serif;
    background:radial-gradient(1200px 600px at 20% -10%, #1a2033 0%, var(--bg) 55%);
    color:var(--text); display:flex; justify-content:center}
  .app{width:100%; max-width:900px; display:flex; flex-direction:column; height:100dvh}

  .card{margin:auto; width:min(440px,92vw); background:var(--panel); border:1px solid var(--line);
    border-radius:18px; padding:26px 24px; box-shadow:0 20px 60px rgba(0,0,0,.45)}
  .card h1{margin:0 0 4px; font-size:26px}
  .card p{margin:0 0 16px; color:var(--muted); font-size:14px}
  label{display:block; font-size:12px; color:var(--muted); margin:14px 0 6px; text-transform:uppercase; letter-spacing:.5px}
  input[type=text]{width:100%; padding:12px 14px; border-radius:12px; border:1px solid var(--line);
    background:var(--panel2); color:var(--text); font-size:15px; outline:none}
  input[type=text]:focus{border-color:var(--accent)}
  .swatches{display:flex; gap:8px; margin-top:8px; flex-wrap:wrap}
  .swatch{width:28px; height:28px; border-radius:50%; cursor:pointer; border:2px solid transparent}
  .swatch.sel{border-color:#fff}
  button.primary{width:100%; margin-top:16px; padding:13px; border:0; border-radius:12px; cursor:pointer;
    background:linear-gradient(135deg,var(--accent),#a486ff); color:#fff; font-size:15px; font-weight:600}
  button.ghostbtn{width:100%; margin-top:10px; padding:11px; border:1px solid var(--line); border-radius:12px;
    cursor:pointer; background:transparent; color:var(--text); font-size:14px}
  .divider{display:flex; align-items:center; gap:10px; color:var(--muted); font-size:12px; margin:20px 0 6px}
  .divider::before,.divider::after{content:""; flex:1; height:1px; background:var(--line)}
  .bignum{font-size:46px; font-weight:800; letter-spacing:6px; text-align:center; color:var(--gold);
    background:var(--panel2); border:1px dashed var(--gold); border-radius:14px; padding:16px; margin:8px 0}
  .codeline{text-align:center; font-size:15px; margin:6px 0 2px}
  .codeline b{color:var(--accent2); letter-spacing:2px}
  .recent{display:flex; flex-direction:column; gap:8px}
  .recent button{display:flex; justify-content:space-between; align-items:center; width:100%; text-align:left;
    background:var(--panel2); border:1px solid var(--line); color:var(--text); padding:11px 14px; border-radius:12px; cursor:pointer; font-size:14px}
  .recent button:hover{border-color:var(--accent)}
  .recent .sub{font-size:12px; color:var(--muted)}

  .chat{display:none; flex-direction:column; height:100dvh}
  header{display:flex; align-items:center; gap:12px; padding:12px 16px; border-bottom:1px solid var(--line); background:var(--panel)}
  header .room{font-weight:700}
  header .me{font-size:12px; color:var(--muted); cursor:pointer}
  header .spacer{flex:1}
  .points{font-weight:800; color:var(--gold); font-size:15px; white-space:nowrap}
  .logout{font-size:11px; color:var(--muted); cursor:pointer; border:1px solid var(--line); padding:3px 8px; border-radius:8px}
  .users{display:flex; gap:6px; flex-wrap:wrap; max-width:40%; justify-content:flex-end}
  .chip{font-size:12px; padding:4px 10px; border-radius:999px; background:var(--panel2); border:1px solid var(--line); cursor:pointer; white-space:nowrap}
  .chip.muted{opacity:.5; text-decoration:line-through}

  .messages{flex:1; overflow-y:auto; padding:18px 16px; display:flex; flex-direction:column; gap:10px}
  .msg{max-width:78%; align-self:flex-start; background:var(--panel); border:1px solid var(--line); padding:8px 12px; border-radius:14px; position:relative}
  .msg.mine{align-self:flex-end; background:#22304a}
  .msg.sys{align-self:center; background:transparent; border:1px dashed var(--gold); color:var(--gold); font-size:13px; text-align:center}
  .msg .author{font-size:12px; font-weight:700; margin-bottom:2px}
  .msg .text{font-size:15px; white-space:pre-wrap; word-wrap:break-word}
  .msg .meta{font-size:10px; color:var(--muted); margin-top:3px}
  .msg .dots{position:absolute; top:6px; right:8px; opacity:0; cursor:pointer; color:var(--muted); font-weight:700; padding:0 4px}
  .msg:hover .dots{opacity:1}

  .composer{display:flex; gap:10px; padding:12px 16px; border-top:1px solid var(--line); background:var(--panel)}
  .composer input{flex:1}
  .composer button{padding:0 20px; border:0; border-radius:12px; background:var(--accent2); color:#04211b; font-weight:700; cursor:pointer}
  .imp-banner{display:none; align-items:center; gap:8px; padding:8px 16px; background:var(--warn); color:#3a2a00; font-size:13px; font-weight:600}
  .imp-banner button{margin-left:auto; background:transparent; border:1px solid #3a2a00; border-radius:8px; padding:3px 8px; cursor:pointer}

  .menu{position:fixed; z-index:50; background:var(--panel2); border:1px solid var(--line); border-radius:12px;
    padding:6px; min-width:240px; max-height:82vh; overflow-y:auto; box-shadow:0 12px 40px rgba(0,0,0,.5); display:none}
  .menu .head{font-size:11px; color:var(--muted); padding:8px 12px 6px; text-transform:uppercase; letter-spacing:.5px}
  .menu button{display:flex; justify-content:space-between; gap:10px; width:100%; text-align:left; background:transparent;
    border:0; color:var(--text); padding:9px 12px; border-radius:8px; cursor:pointer; font-size:14px}
  .menu button:hover{background:var(--panel)}
  .menu button .cost{color:var(--gold); font-weight:700; font-size:12px; white-space:nowrap}
  .menu button.danger{color:var(--danger)}
  .menu .sep{height:1px; background:var(--line); margin:5px 0}
  .menu .colorrow{display:flex; gap:6px; padding:6px 10px; flex-wrap:wrap}
  .menu .colorrow .swatch{width:22px;height:22px}

  .toast{position:fixed; bottom:90px; left:50%; transform:translateX(-50%); background:var(--panel2); border:1px solid var(--line);
    color:var(--text); padding:10px 16px; border-radius:10px; font-size:14px; display:none; z-index:60; box-shadow:0 8px 30px rgba(0,0,0,.5); max-width:80vw; text-align:center}
</style>
</head>
<body>
<div class="app">

  <!-- LOBBY -->
  <div class="card" id="lobbyScreen">
    <h1>ChaosChat 😈</h1>
    <p>Maak een chat of groep, deel de code, en trol elkaar suf. Chatten = punten. Punten = macht.</p>

    <div id="recentWrap" style="display:none">
      <label>Jouw chats op dit apparaat</label>
      <div class="recent" id="recentList"></div>
    </div>

    <div class="divider">nieuwe chat maken</div>
    <label>Jouw weergavenaam</label>
    <input type="text" id="nameInput" placeholder="bijv. Sem" autocomplete="off" />
    <label>Kleur</label>
    <div class="swatches" id="colorSwatches"></div>
    <button class="primary" id="createBtn">➕ Maak chat + krijg code</button>

    <div class="divider">of join met een code</div>
    <input type="text" id="roomInput" placeholder="chat-code van een vriend" autocomplete="off" />
    <button class="ghostbtn" id="joinBtn">Join deze chat</button>
  </div>

  <!-- REVEAL -->
  <div class="card" id="revealScreen" style="display:none">
    <h1>Klaar! 🔑</h1>
    <p>Bewaar allebei goed. Dit apparaat logt je automatisch weer in; op een ander apparaat heb je je nummer nodig ;-;</p>
    <div class="codeline">Deel deze chat-code met je vrienden:</div>
    <div class="codeline"><b id="revealCode">xxxx</b></div>
    <div class="codeline" style="margin-top:14px">Jouw geheime nummer:</div>
    <div class="bignum" id="revealNum">0000</div>
    <button class="primary" id="enterBtn">Ik heb het onthouden → chat in</button>
  </div>

  <!-- CHAT -->
  <div class="chat" id="chatScreen">
    <header>
      <div><div class="room" id="roomLabel">#kamer</div><div class="me" id="meLabel" title="klik om code te kopiëren"></div></div>
      <div class="spacer"></div>
      <div class="points" id="pointsLabel">⭐ 0</div>
      <div class="logout" id="lobbyBtn">chats</div>
      <div class="users" id="userList"></div>
    </header>
    <div class="imp-banner" id="impBanner"><span id="impText"></span><button id="impCancel">Stop</button></div>
    <div class="messages" id="messages"></div>
    <div class="composer">
      <input type="text" id="msgInput" placeholder="Typ een bericht… (+1 punt)" autocomplete="off" />
      <button id="sendBtn">Stuur</button>
    </div>
  </div>
</div>

<div class="menu" id="menu"></div>
<div class="toast" id="toast"></div>

<script type="module">
import { initializeApp } from "https://www.gstatic.com/firebasejs/10.12.0/firebase-app.js";
import { getDatabase, ref, push, set, update, get, onValue, onDisconnect, runTransaction }
  from "https://www.gstatic.com/firebasejs/10.12.0/firebase-database.js";

// ============================================================
//  JOUW FIREBASE CONFIG (al ingevuld)
// ============================================================
const firebaseConfig = {
  apiKey: "AIzaSyCzanS5BHzB9Iu4HY9QJKS7Ju9wS47eXPQ",
  authDomain: "chaoschat-c4b89.firebaseapp.com",
  databaseURL: "https://chaoschat-c4b89-default-rtdb.europe-west1.firebasedatabase.app",
  projectId: "chaoschat-c4b89",
  storageBucket: "chaoschat-c4b89.firebasestorage.app",
  messagingSenderId: "541022881356",
  appId: "1:541022881356:web:adfac4dfea6d2eaeed96e9",
  measurementId: "G-PPCR4PZCFL"
};
const app = initializeApp(firebaseConfig);
const db = getDatabase(app);

// ============================================================
//  TROLL-KOSTEN (punten)
// ============================================================
const COST = {
  reverse:8, emoji:10, color:10, give:10, scramble:12, shout:12, label:12,
  echo:15, replace:15, roulette:15, sysmsg:15,
  ghost:18, steal:20, gamble:20, del:20, mute:25, rename:25,
  rainbow:30, edit:30, kick:35, freeze:40, stealall:60
};
const BAN_MS = 60000; // kick = 60s niet meer terug kunnen (overleeft refresh)

const COLORS = ["#7c5cff","#00d3a7","#ff5d6c","#ffb020","#39a0ff","#ff7ac2","#8bd450","#e0e0e0"];
const BOMB = ["💥","🤡","💩","🔥","👺","🫠","🐍","💀","🎉","🥴","😈","🤪"];

let room=null, myNum=null, myColor=localStorage.getItem("chaos_color")||COLORS[0];
let users={}, lastMsgs={}, impersonate=null, freezeUntil=0, pending=null, subs=[];

// ---------- localStorage: meerdere accounts ----------
function loadAcc(){ try{ return JSON.parse(localStorage.getItem("chaos_accounts")||"{}"); }catch(e){ return {}; } }
function saveAcc(code,num,name){ const a=loadAcc(); a[code]={num,name}; localStorage.setItem("chaos_accounts",JSON.stringify(a)); localStorage.setItem("chaos_last",code); }

// ---------- Lobby UI ----------
const swatches=document.getElementById("colorSwatches");
COLORS.forEach(c=>{ const d=document.createElement("div");
  d.className="swatch"+(c===myColor?" sel":""); d.style.background=c;
  d.onclick=()=>{ myColor=c; localStorage.setItem("chaos_color",c);
    [...swatches.children].forEach(x=>x.classList.remove("sel")); d.classList.add("sel"); };
  swatches.appendChild(d); });
document.getElementById("nameInput").value=localStorage.getItem("chaos_name")||"";
document.getElementById("createBtn").onclick=createChat;
document.getElementById("joinBtn").onclick=()=>joinChat(document.getElementById("roomInput").value);
document.getElementById("enterBtn").onclick=()=>{ if(pending) enterChat(pending.code,pending.num); };
document.getElementById("lobbyBtn").onclick=goLobby;

function renderRecent(){
  const acc=loadAcc(); const wrap=document.getElementById("recentWrap"); const list=document.getElementById("recentList");
  const codes=Object.keys(acc); if(!codes.length){ wrap.style.display="none"; return; }
  wrap.style.display="block"; list.innerHTML="";
  codes.forEach(code=>{ const b=document.createElement("button");
    b.innerHTML=`<span>▶ ${escapeHtml(acc[code].name||code)}</span><span class="sub">code ${code} · #${acc[code].num}</span>`;
    b.onclick=()=>enterChat(code,acc[code].num); list.appendChild(b); });
}
function goLobby(){ detach(); room=null; myNum=null;
  document.getElementById("chatScreen").style.display="none";
  document.getElementById("revealScreen").style.display="none";
  document.getElementById("lobbyScreen").style.display="block"; renderRecent();
}

const genCode=()=>Math.random().toString(36).slice(2,8);
const clean=s=>(s||"").trim().toLowerCase().replace(/[^a-z0-9_-]/g,"");

// ---------- Auto-inlog (saven) ----------
window.addEventListener("load", async ()=>{
  renderRecent();
  const last=localStorage.getItem("chaos_last"); const acc=loadAcc();
  if(last && acc[last]){
    try{ const s=await get(ref(db,`rooms/${last}/users/${acc[last].num}`));
      if(s.exists()) enterChat(last,acc[last].num); }catch(e){}
  }
});

// ---------- Chat maken / joinen ----------
async function createIdentity(code){
  const name=document.getElementById("nameInput").value.trim()||"Speler";
  localStorage.setItem("chaos_name",name);
  let num,tries=0;
  do{ num=String(Math.floor(1000+Math.random()*9000)); tries++;
      const s=await get(ref(db,`rooms/${code}/users/${num}`)); if(!s.exists()) break; }while(tries<50);
  await set(ref(db,`rooms/${code}/users/${num}`),{name,color:myColor,mutedUntil:0,hiddenUntil:0,bannedUntil:0,points:0,online:true});
  saveAcc(code,num,name); return num;
}
async function createChat(){
  const code=genCode(); const name=document.getElementById("nameInput").value.trim()||"Speler";
  await set(ref(db,`rooms/${code}/meta/name`), (name?name+"'s chat":"Chaos-chat"));
  const num=await createIdentity(code);
  showReveal(code,num);
}
async function joinChat(raw){
  const code=clean(raw); if(!code){ toast("Vul een chat-code in."); return; }
  const acc=loadAcc();
  if(acc[code]){ // al een account op dit apparaat
    const s=await get(ref(db,`rooms/${code}/users/${acc[code].num}`));
    if(s.exists()){ enterChat(code,acc[code].num); return; }
  }
  // check of de chat bestaat
  const meta=await get(ref(db,`rooms/${code}`));
  if(!meta.exists()){ toast("Die chat bestaat (nog) niet 🫠"); return; }
  // bestaand nummer (ander apparaat) of nieuw?
  const existing=prompt("Heb je hier al een nummer? Vul het in, of laat leeg voor een nieuw account:");
  if(existing && existing.trim()){
    const n=existing.trim(); const s=await get(ref(db,`rooms/${code}/users/${n}`));
    if(!s.exists()){ toast("Dat nummer bestaat niet in deze chat."); return; }
    saveAcc(code,n,s.val().name); enterChat(code,n); return;
  }
  const num=await createIdentity(code); showReveal(code,num);
}
function showReveal(code,num){
  pending={code,num};
  document.getElementById("revealCode").textContent=code;
  document.getElementById("revealNum").textContent=num;
  document.getElementById("lobbyScreen").style.display="none";
  document.getElementById("revealScreen").style.display="block";
}

// ---------- Chat binnengaan ----------
function detach(){ subs.forEach(u=>{try{u();}catch(e){}}); subs=[]; }
async function enterChat(code,num){
  // ban-check die een refresh overleeft
  try{ const s=await get(ref(db,`rooms/${code}/users/${num}`));
    if(s.exists() && (s.val().bannedUntil||0)>Date.now()){
      toast(`Je bent uit deze chat geschopt — nog ${Math.ceil((s.val().bannedUntil-Date.now())/1000)}s`); goLobby(); return; }
  }catch(e){}
  detach(); room=code; myNum=num; impersonate=null;
  document.getElementById("lobbyScreen").style.display="none";
  document.getElementById("revealScreen").style.display="none";
  document.getElementById("chatScreen").style.display="flex";
  document.getElementById("meLabel").textContent="code: "+code+" · jouw nr: "+num;
  update(ref(db,`rooms/${room}/users/${myNum}`),{online:true});
  onDisconnect(ref(db,`rooms/${room}/users/${myNum}/online`)).set(false);
  get(ref(db,`rooms/${room}/meta/name`)).then(s=>{ document.getElementById("roomLabel").textContent=s.val()||("#"+code); });
  listen(); document.getElementById("msgInput").focus();
}
document.getElementById("meLabel").onclick=()=>{ if(room){ navigator.clipboard?.writeText(room); toast("Chat-code gekopieerd: "+room); } };

// ---------- Live data ----------
function listen(){
  subs.push(onValue(ref(db,`rooms/${room}/users`),s=>{ users=s.val()||{}; if(checkBanned())return; renderUsers(); renderMessages(); updatePoints(); }));
  subs.push(onValue(ref(db,`rooms/${room}/messages`),s=>{ lastMsgs=s.val()||{}; renderMessages(); }));
  subs.push(onValue(ref(db,`rooms/${room}/meta/freezeUntil`),s=>{ freezeUntil=s.val()||0; }));
}
setInterval(()=>{ if(room){ renderUsers(); renderMessages(); } },1000);
function updatePoints(){ const p=document.getElementById("pointsLabel"); if(p) p.textContent="⭐ "+(users[myNum]?.points||0); }
function checkBanned(){ if(room && users[myNum] && (users[myNum].bannedUntil||0)>Date.now()){ toast("Je bent uit de chat geschopt 💀"); goLobby(); return true; } return false; }

// ---------- Render ----------
function renderUsers(){
  const el=document.getElementById("userList"); if(!el) return; el.innerHTML="";
  Object.entries(users).forEach(([num,u])=>{ const c=document.createElement("div");
    const muted=(u.mutedUntil||0)>Date.now();
    c.className="chip"+(muted?" muted":""); c.style.color=u.color||"#fff";
    c.textContent=(u.name||"Speler")+" #"+num+(num===myNum?" (jij)":"");
    c.onclick=e=>openMenu(e,num,null); el.appendChild(c); });
  updatePoints();
}
function renderMessages(){
  const box=document.getElementById("messages"); if(!box||!room) return;
  const near=box.scrollHeight-box.scrollTop-box.clientHeight<120; box.innerHTML="";
  Object.entries(lastMsgs).sort((a,b)=>(a[1].ts||0)-(b[1].ts||0)).forEach(([mid,m])=>{
    if(m.deleted) return;
    if(m.sys){ const d=document.createElement("div"); d.className="msg sys"; d.textContent="📢 "+m.text; box.appendChild(d); return; }
    const a=users[m.authorUid]; if(a&&(a.hiddenUntil||0)>Date.now()) return;
    const color=a?a.color:(m.color||"#ddd"); const name=(a?a.name:m.name)||"Speler";
    const div=document.createElement("div"); div.className="msg"+(m.authorUid===myNum?" mine":"");
    div.innerHTML=`<div class="author" style="color:${color}">${escapeHtml(name)} #${m.authorUid}</div>
      <div class="text">${escapeHtml(m.text)}</div>
      <div class="meta">${m.edited?"bewerkt · ":""}${fmt(m.ts)}</div><div class="dots">⋯</div>`;
    div.querySelector(".dots").onclick=e=>openMenu(e,m.authorUid,mid); box.appendChild(div);
  });
  if(near) box.scrollTop=box.scrollHeight;
}

// ---------- Sturen (+1 punt) ----------
document.getElementById("sendBtn").onclick=send;
document.getElementById("msgInput").addEventListener("keydown",e=>{ if(e.key==="Enter") send(); });
function send(){
  const input=document.getElementById("msgInput"); const text=input.value.trim(); if(!text||!room) return;
  if(Date.now()<freezeUntil){ toast(`❄️ Chat bevroren — nog ${Math.ceil((freezeUntil-Date.now())/1000)}s`); return; }
  const me=users[myNum];
  if(me&&(me.mutedUntil||0)>Date.now()){ toast(`Je bent getimed-out — nog ${Math.ceil((me.mutedUntil-Date.now())/1000)}s (geen punten 😢)`); return; }
  const asId=impersonate||myNum; const asUser=users[asId]||{};
  push(ref(db,`rooms/${room}/messages`),{authorUid:asId,realUid:myNum,name:asUser.name||"Speler",color:asUser.color||myColor,text,ts:Date.now(),edited:false});
  runTransaction(ref(db,`rooms/${room}/users/${myNum}/points`),p=>(p||0)+1);
  input.value=""; if(impersonate) stopImpersonate();
}

// ============================================================
//  MENU + POWERS
// ============================================================
const menu=document.getElementById("menu");
function place(x,y){ menu.style.left=Math.min(x,innerWidth-250)+"px"; menu.style.top=Math.max(8,Math.min(y,innerHeight-420))+"px"; menu.style.display="block"; }
document.addEventListener("click",e=>{ if(!menu.contains(e.target)&&!e.target.classList.contains("dots")&&!e.target.classList.contains("chip")) menu.style.display="none"; });

function openMenu(e,target,mid){
  e.stopPropagation(); const nm=escapeHtml(nameOf(target));
  const R=(a,l,c)=>`<button data-a="${a}">${l}<span class="cost">${c}⭐</span></button>`;
  let html=`<div class="head">Op ${nm} #${target}</div>`;
  if(mid){ html+=
    R("edit","✏️ Bericht editen",COST.edit)+
    `<button data-a="del" class="danger">🗑️ Verwijderen<span class="cost">${COST.del}⭐</span></button>`+
    R("scramble","🔀 Husselen",COST.scramble)+R("shout","🔊 CAPS",COST.shout)+
    R("reverse","↩️ Omdraaien",COST.reverse)+R("emoji","🧨 Emoji-bom",COST.emoji)+
    R("echo","🔁 Echo (x3)",COST.echo)+R("replace","🗣️ Woord vervangen",COST.replace)+`<div class="sep"></div>`; }
  html+=R("rename","📛 Hernoemen",COST.rename)+R("label","🏷️ Label plakken",COST.label)+
    R("mute","🔇 Time-out",COST.mute)+R("ghost","👻 Ghosten 20s",COST.ghost)+
    R("kick","💀 Uit chat schoppen (60s)",COST.kick)+R("steal","💸 Punten stelen",COST.steal)+
    R("stealall","👑 ALLE punten stelen",COST.stealall)+R("give","🎁 10 punten geven",COST.give)+
    R("imp","🎭 Voordoen als",COST.imp)+`<button data-a="unmute">🔊 Time-out opheffen<span class="cost">gratis</span></button>`+
    `<div class="head">Kleur (${COST.color}⭐)</div><div class="colorrow">${COLORS.map(c=>`<div class="swatch" data-color="${c}" style="background:${c}"></div>`).join("")}</div>`+
    `<div class="head">Chaos voor iedereen</div>`+
    R("rainbow","🌈 Ieders kleur randomizen",COST.rainbow)+R("freeze","❄️ Chat 8s bevriezen",COST.freeze)+
    R("roulette","🎲 Willekeurige troll",COST.roulette)+R("sysmsg","📢 Nep-systeembericht",COST.sysmsg)+
    R("gamble","🪙 Gok 20 (dubbel of niks)",COST.gamble);
  menu.innerHTML=html; place(e.clientX,e.clientY);
  const A=a=>menu.querySelector(`[data-a=${a}]`); const close=()=>menu.style.display="none";

  if(A("edit")) A("edit").onclick=()=>{ close(); const t=prompt("Nieuwe tekst:",lastMsgs[mid]?.text||""); if(t===null) return; spend(COST.edit,"Editen",()=>update(ref(db,`rooms/${room}/messages/${mid}`),{text:t,edited:true})); };
  if(A("del")) A("del").onclick=()=>{ close(); spend(COST.del,"Verwijderen",()=>update(ref(db,`rooms/${room}/messages/${mid}`),{deleted:true})); };
  if(A("scramble")) A("scramble").onclick=()=>{ close(); spend(COST.scramble,"Husselen",()=>editMsg(mid,t=>t.split("").sort(()=>Math.random()-.5).join(""))); };
  if(A("shout")) A("shout").onclick=()=>{ close(); spend(COST.shout,"CAPS",()=>editMsg(mid,t=>t.toUpperCase()+"!!")); };
  if(A("reverse")) A("reverse").onclick=()=>{ close(); spend(COST.reverse,"Omdraaien",()=>editMsg(mid,t=>t.split("").reverse().join(""))); };
  if(A("emoji")) A("emoji").onclick=()=>{ close(); spend(COST.emoji,"Emoji-bom",()=>editMsg(mid,t=>t+" "+Array.from({length:6},()=>BOMB[Math.floor(Math.random()*BOMB.length)]).join(""))); };
  if(A("echo")) A("echo").onclick=()=>{ close(); spend(COST.echo,"Echo",()=>{ const m=lastMsgs[mid]; if(!m) return; for(let i=0;i<3;i++) push(ref(db,`rooms/${room}/messages`),{authorUid:m.authorUid,realUid:myNum,name:nameOf(m.authorUid),color:users[m.authorUid]?.color||"#ddd",text:m.text,ts:Date.now()+i,edited:false}); }); };
  if(A("replace")) A("replace").onclick=()=>{ close(); const from=prompt("Welk woord vervangen?"); if(!from) return; const to=prompt("Waarmee?","🐒")||""; spend(COST.replace,"Vervangen",()=>editMsg(mid,t=>t.split(from).join(to))); };

  A("rename").onclick=()=>{ close(); const n=prompt(`Nieuwe naam voor #${target}:`,nameOf(target)); if(!n) return; spend(COST.rename,"Hernoemen",()=>update(ref(db,`rooms/${room}/users/${target}`),{name:n})); };
  A("label").onclick=()=>{ close(); const tag=prompt("Welk label ervoor plakken?","🤡 "); if(tag===null) return; spend(COST.label,"Label",()=>update(ref(db,`rooms/${room}/users/${target}`),{name:tag+nameOf(target)})); };
  A("mute").onclick=()=>{ close(); const sec=parseInt(prompt("Hoeveel seconden time-out?","60")||"0",10); if(!(sec>0)) return; spend(COST.mute,"Time-out",()=>update(ref(db,`rooms/${room}/users/${target}`),{mutedUntil:Date.now()+sec*1000})); };
  A("unmute").onclick=()=>{ close(); update(ref(db,`rooms/${room}/users/${target}`),{mutedUntil:0}); };
  A("ghost").onclick=()=>{ close(); spend(COST.ghost,"Ghosten",()=>update(ref(db,`rooms/${room}/users/${target}`),{hiddenUntil:Date.now()+20000})); };
  A("kick").onclick=()=>{ close(); spend(COST.kick,"Kick",()=>update(ref(db,`rooms/${room}/users/${target}`),{bannedUntil:Date.now()+BAN_MS})); };
  A("steal").onclick=()=>{ close(); stealPoints(target,10); };
  A("stealall").onclick=()=>{ close(); stealPoints(target,Infinity,COST.stealall); };
  A("give").onclick=()=>{ close(); givePoints(target); };
  A("imp").onclick=()=>{ close(); spend(COST.imp,"Voordoen als",()=>startImpersonate(target)); };
  menu.querySelectorAll(".swatch").forEach(s=> s.onclick=()=>{ close(); spend(COST.color,"Kleur",()=>update(ref(db,`rooms/${room}/users/${target}`),{color:s.dataset.color})); });
  A("rainbow").onclick=()=>{ close(); spend(COST.rainbow,"Regenboog",()=>Object.keys(users).forEach(u=>update(ref(db,`rooms/${room}/users/${u}`),{color:COLORS[Math.floor(Math.random()*COLORS.length)]}))); };
  A("freeze").onclick=()=>{ close(); spend(COST.freeze,"Bevriezen",()=>set(ref(db,`rooms/${room}/meta/freezeUntil`),Date.now()+8000)); };
  A("sysmsg").onclick=()=>{ close(); const t=prompt("Wat moet het 'systeem' zeggen?"); if(!t) return; spend(COST.sysmsg,"Systeembericht",()=>push(ref(db,`rooms/${room}/messages`),{sys:true,text:t,ts:Date.now()})); };
  A("gamble").onclick=()=>{ close(); gamble(); };
  A("roulette").onclick=()=>{ close(); roulette(); };
}

// ---- punten ----
async function spend(cost,label,fn){
  const res=await runTransaction(ref(db,`rooms/${room}/users/${myNum}/points`),p=>{ p=p||0; if(p<cost) return; return p-cost; });
  if(!res.committed){ toast(`Niet genoeg punten! "${label}" kost ${cost}⭐. Chat eerst 💬`); return; } await fn();
}
async function stealPoints(target,max,cost=COST.steal){
  if(target===myNum){ toast("Van jezelf stelen? 🤨"); return; }
  const res=await runTransaction(ref(db,`rooms/${room}/users/${myNum}/points`),p=>{ p=p||0; if(p<cost) return; return p-cost; });
  if(!res.committed){ toast(`Dit kost ${cost}⭐. Chat eerst 💬`); return; }
  let stolen=0; await runTransaction(ref(db,`rooms/${room}/users/${target}/points`),p=>{ p=p||0; stolen=Math.min(max,p); return p-stolen; });
  if(stolen>0) await runTransaction(ref(db,`rooms/${room}/users/${myNum}/points`),p=>(p||0)+stolen);
  toast(`Je stal ${stolen}⭐ van ${nameOf(target)} 😈`);
}
async function givePoints(target){
  if(target===myNum){ toast("Aan jezelf geven doet niks 🙃"); return; }
  const res=await runTransaction(ref(db,`rooms/${room}/users/${myNum}/points`),p=>{ p=p||0; if(p<COST.give) return; return p-COST.give; });
  if(!res.committed){ toast(`Geven kost ${COST.give}⭐. Chat eerst 💬`); return; }
  await runTransaction(ref(db,`rooms/${room}/users/${target}/points`),p=>(p||0)+COST.give);
  toast(`Je gaf ${COST.give}⭐ aan ${nameOf(target)} 🎁`);
}
async function gamble(){
  const res=await runTransaction(ref(db,`rooms/${room}/users/${myNum}/points`),p=>{ p=p||0; if(p<COST.gamble) return; return p-COST.gamble; });
  if(!res.committed){ toast(`Gokken kost ${COST.gamble}⭐. Chat eerst 💬`); return; }
  if(Math.random()<0.5){ await runTransaction(ref(db,`rooms/${room}/users/${myNum}/points`),p=>(p||0)+COST.gamble*2); toast(`🪙 GEWONNEN! +${COST.gamble}⭐ netto 🥳`); }
  else toast(`🪙 Verloren… ${COST.gamble}⭐ weg 💸`);
}
async function roulette(){
  const others=Object.keys(users).filter(u=>u!==myNum); if(!others.length){ toast("Niemand om te trollen 😅"); return; }
  const t=others[Math.floor(Math.random()*others.length)];
  const acts=[
    ()=>update(ref(db,`rooms/${room}/users/${t}`),{color:COLORS[Math.floor(Math.random()*COLORS.length)]}),
    ()=>update(ref(db,`rooms/${room}/users/${t}`),{mutedUntil:Date.now()+30000}),
    ()=>update(ref(db,`rooms/${room}/users/${t}`),{hiddenUntil:Date.now()+15000}),
    ()=>update(ref(db,`rooms/${room}/users/${t}`),{name:"🤡 "+nameOf(t)}),
  ];
  spend(COST.roulette,"Roulette",()=>{ acts[Math.floor(Math.random()*acts.length)](); toast(`🎲 Roulette raakte ${nameOf(t)}!`); });
}
function editMsg(mid,fn){ const m=lastMsgs[mid]; if(m) update(ref(db,`rooms/${room}/messages/${mid}`),{text:fn(m.text||""),edited:true}); }

// ---- impersonate ----
function startImpersonate(t){ impersonate=t; document.getElementById("impText").textContent=`🎭 Je volgende bericht komt op naam van ${nameOf(t)} #${t}.`; document.getElementById("impBanner").style.display="flex"; document.getElementById("msgInput").focus(); }
function stopImpersonate(){ impersonate=null; document.getElementById("impBanner").style.display="none"; }
document.getElementById("impCancel").onclick=stopImpersonate;

// ---- helpers ----
function nameOf(n){ return users[n]?.name||"Speler"; }
function fmt(ts){ if(!ts) return ""; const d=new Date(ts); return d.getHours().toString().padStart(2,"0")+":"+d.getMinutes().toString().padStart(2,"0"); }
function escapeHtml(s){ return (s||"").replace(/[&<>"']/g,c=>({ "&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;" }[c])); }
function toast(m){ const t=document.getElementById("toast"); t.textContent=m; t.style.display="block"; clearTimeout(t._t); t._t=setTimeout(()=>t.style.display="none",2800); }
</script>
